# Sample environment file. Copy to .env and fill in your own values.
#   cp .env.example .env
# Real .env files are gitignored and must never be committed.

# 01_Hello_LC.py: Groq through ChatGroq
GROQ_API_KEY=gsk_your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b

# 02_DeepSeek_LC.py: ChatDeepSeek reads DEEPSEEK_API_KEY from the environment
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here

# 03_Ollama_LC.py: no key needed, runs against a local Ollama
#   ollama pull gemma3:270m

# 04_Geminy_LC.py and 05_Gemini_Steam_LC.py: create_agent needs the provider prefix
GOOGLE_API_KEY=your_google_ai_studio_api_key_here
GEMINI_LLM_MODEL=google_genai:gemini-2.5-flash
